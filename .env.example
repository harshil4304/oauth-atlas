# Required for live guide generation. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: model for the research + checker passes (default: claude-sonnet-5-5)
OAUTH_ATLAS_MODEL=

# Optional: persistent storage for generated guides (Upstash Redis REST).
# Without these, generated guides are kept in a local .data/ folder and every
# guide can still be shared through a self-contained link.
# Vercel's Upstash/KV integration may name these KV_REST_API_URL and KV_REST_API_TOKEN;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: checks whether Composio provides a managed OAuth app for an app
# (used by live generation and by `npm run sync:composio`).
COMPOSIO_API_KEY=

# Optional: protect the generate endpoint from strangers burning your API credits.
# If set, the generate form asks for this passcode.
GENERATE_PASSCODE=
