# Copy this file to .env.local and fill in values there. .env.local is git-ignored:
# never put real keys in this file or anywhere else in the repo.

# ── Model for live guide generation (set ONE of these) ──────────────────────────
# Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Gemini model. Default gemini-3.5-flash-lite (largest free daily quota).
# gemini-3.8-flash writes better guides but its free quota is small (check
# https://aistudio.google.com/rate-limit).
GEMINI_MODEL=

# Claude (paid): key from https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional Claude model (default claude-sonnet-5-5)
OAUTH_ATLAS_MODEL=

# Optional: force a provider when both keys are set: gemini or anthropic.
# Default: Gemini if GEMINI_API_KEY is set, otherwise Claude.
LLM_PROVIDER=

# ── Storage for generated guides (optional) ─────────────────────────────────────
# Upstash Redis REST. Without these, generated guides are kept in a local .data/
# folder and every guide can still be shared through a self-contained link.
# Vercel's Upstash/KV integration may name these KV_REST_API_URL and KV_REST_API_TOKEN;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Other (optional) ────────────────────────────────────────────────────────────
# Checks whether Composio provides a managed OAuth app for an app
# (used by live generation and by `npm run sync:composio`).
COMPOSIO_API_KEY=

# Protect the generate endpoint from strangers using up your API quota.
# If set, the generate form asks for this passcode.
GENERATE_PASSCODE=
